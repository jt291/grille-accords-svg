{
  "name": "grille-accords-svg",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --port 4317 --strictPort --open /",
    "docs": "typedoc",
    "build": "tsc -b && vite build && mkdir -p dist/client/GrilleAccordsHelp dist/server && cp GrilleAccordsHelp/GA_Langage.html GrilleAccordsHelp/HelpStyles.css dist/client/GrilleAccordsHelp/ && cp worker/index.js dist/server/index.js",
    "preview": "pnpm run build && vite preview --port 4318 --strictPort --open /",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@iconify-icons/mdi": "^1.2.48",
    "@iconify/react": "^6.0.2",
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "vitest": "latest"
  },
  "packageManager": "pnpm@10.14.0"
}
